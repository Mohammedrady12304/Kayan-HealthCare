generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  FINANCE
}

enum VisitStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  patient Patient?
  doctor  Doctor?
  finance Finance?

  @@map("users")
}

model Patient {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  visits Visit[]

  @@map("patients")
}

model Doctor {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  specialty String?

  visits Visit[]
  slots  Slot[]

  @@map("doctors")
}
model Slot {
  id        String     @id @default(uuid())
  doctorId  String
  startTime DateTime
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())

  doctor Doctor  @relation(fields: [doctorId], references: [id])
  visits Visit[] 
  @@unique([doctorId, startTime])
  @@map("slots")
}

model Finance {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  @@map("finance")
}

model Visit {
  id              String      @id @default(uuid())
  patientId       String
  doctorId        String
  slotId          String
  status          VisitStatus @default(PENDING)
  notes           String?
  rejectionReason String?
  meetingLink     String?
  totalAmount     Decimal     @default(0) @db.Decimal(10, 2)
  startedAt       DateTime?
  completedAt     DateTime?

  patient    Patient     @relation(fields: [patientId], references: [id])
  doctor     Doctor      @relation(fields: [doctorId], references: [id])
  slot       Slot        @relation(fields: [slotId], references: [id])
  treatments Treatment[]

  @@map("visits")
}

model Treatment {
  id      String  @id @default(uuid())
  visitId String
  name    String
  value   Decimal @db.Decimal(10, 2)

  visit Visit @relation(fields: [visitId], references: [id])

  @@map("treatments")
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  EXPIRED
  CANCELLED
}
